{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nomo",
        "width": 1180,
        "height": 760,
        "minWidth": 920,
        "minHeight": 640,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "skipTaskbar": false
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "startMenuFolder": "Nomo",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "customLanguageFiles": {
          "SimpChinese": "installer/SimpChinese.nsh"
        },
        "installerHooks": "installer/windows-open-with.nsh"
      }
    }
  }
}
