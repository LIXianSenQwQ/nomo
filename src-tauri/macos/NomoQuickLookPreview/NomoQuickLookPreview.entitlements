<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Quick Look 扩展必须启用 App Sandbox -->
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <!-- 允许读取用户选择的文件（Quick Look 传入的文件 URL） -->
  <key>com.apple.security.files.user-selected.read-only</key>
  <true/>
  <!-- 只允许读取主应用的原生配置，以同步主题偏好；不授予其他 Application Support 目录。 -->
  <key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
  <array>
    <string>/Library/Application Support/com.nomo.desktop/</string>
  </array>
  <!-- WKWebView 即使只渲染本地 HTML，也会启动受网络沙盒约束的 GPU/Network/WebContent 子进程。 -->
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
